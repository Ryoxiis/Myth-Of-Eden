{% extends 'base.html.twig' %}

{% block title %}Connexion · Myth of Eden{% endblock %}
{% block body_class %}page-auth{% endblock %}

{% block body %}
    <section class="join join--page">
        {{ include('partials/_hero_scene.html.twig', {image: 'village.jpg', position: 'center 70%'}) }}
        <div class="join__shade"></div>
        <div class="join__panel">
            <p class="eyebrow eyebrow--gold">Bon retour parmi nous</p>
            <h1 class="join__title">Connexion</h1>

            {% if error %}
                <p class="flash flash--error">E-mail ou mot de passe incorrect.</p>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="form">
                <div>
                    <label for="email">Adresse e-mail</label>
                    <input type="email" id="email" name="email" value="{{ last_username }}" autocomplete="email" required autofocus>
                </div>

                <div>
                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="password" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="form-actions">
                    <button type="submit" class="btn btn--primary btn--glow">Se connecter</button>
                </div>
            </form>

            <p class="form-footer">Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a></p>
        </div>
    </section>
{% endblock %}
