{#
    Décor dessiné en SVG (ancienne bannière), gardé en secours.
    Pour l'utiliser à la place de la photo : remplace le contenu de _hero_scene.html.twig par
    {{ include('partials/_hero_illustration.html.twig') }}
#}
<svg class="hero-scene" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
    <defs>
        <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#0d1621"/>
            <stop offset="0.55" stop-color="#1b2d3c"/>
            <stop offset="1" stop-color="#22394a"/>
        </linearGradient>
        <radialGradient id="glow" cx="0.5" cy="0.55" r="0.5">
            <stop offset="0" stop-color="#e8fffa" stop-opacity="1"/>
            <stop offset="0.1" stop-color="#9ff0e2" stop-opacity="0.85"/>
            <stop offset="0.32" stop-color="#3fa6b4" stop-opacity="0.4"/>
            <stop offset="0.6" stop-color="#2a6f86" stop-opacity="0.15"/>
            <stop offset="1" stop-color="#1b2d3c" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id="moon-halo" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0" stop-color="#f3e7c4" stop-opacity="0.35"/>
            <stop offset="1" stop-color="#f3e7c4" stop-opacity="0"/>
        </radialGradient>
        <linearGradient id="mist" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#9ccfd2" stop-opacity="0"/>
            <stop offset="1" stop-color="#9ccfd2" stop-opacity="0.18"/>
        </linearGradient>
        <g id="pine">
            <path d="M0 0 L-28 60 H-12 L-40 120 H-18 L-54 190 H54 L18 120 H40 L12 60 H28 Z"/>
            <rect x="-6" y="190" width="12" height="30"/>
        </g>
    </defs>

    <rect width="1600" height="900" fill="url(#sky)"/>

    {# étoiles #}
    <g fill="#e9f4ff">
        <circle cx="120" cy="90" r="1.4" opacity="0.8"/><circle cx="260" cy="160" r="1"/><circle cx="410" cy="70" r="1.6" opacity="0.7"/>
        <circle cx="560" cy="140" r="1" opacity="0.6"/><circle cx="700" cy="60" r="1.3"/><circle cx="930" cy="110" r="1" opacity="0.7"/>
        <circle cx="1060" cy="50" r="1.5" opacity="0.8"/><circle cx="1210" cy="150" r="1"/><circle cx="1340" cy="80" r="1.4" opacity="0.6"/>
        <circle cx="1480" cy="130" r="1.1"/><circle cx="1540" cy="40" r="1.5" opacity="0.7"/><circle cx="60" cy="220" r="1" opacity="0.5"/>
        <circle cx="840" cy="200" r="1" opacity="0.5"/><circle cx="1420" cy="240" r="1" opacity="0.5"/><circle cx="330" cy="250" r="1.2" opacity="0.5"/>
    </g>

    {# lune #}
    <circle cx="1250" cy="170" r="140" fill="url(#moon-halo)"/>
    <circle cx="1250" cy="170" r="38" fill="#efe3c0" opacity="0.9"/>
    <circle cx="1266" cy="160" r="34" fill="#1a2b3a" opacity="0.55"/>

    {# montagnes lointaines #}
    <path d="M0 560 L180 440 L300 500 L470 380 L640 480 L800 400 L980 490 L1140 390 L1320 470 L1460 420 L1600 470 V900 H0 Z" fill="#203546" opacity="0.9"/>

    {# lumière au cœur de la forêt #}
    <circle class="hero-glow" cx="800" cy="640" r="460" fill="url(#glow)"/>

    {# ruine : arche et colonnes brisées #}
    <g fill="#162836">
        <path d="M700 700 V560 Q800 470 900 560 V700 H860 V575 Q800 520 740 575 V700 Z"/>
        <rect x="640" y="600" width="34" height="100"/>
        <rect x="926" y="620" width="34" height="80"/>
        <path d="M640 600 L652 588 L674 596 V600 Z"/>
        <rect x="610" y="690" width="380" height="16"/>
    </g>

    {# forêt : plans successifs #}
    <g fill="#172a38">
        <use href="#pine" transform="translate(140 470) scale(1.3)"/>
        <use href="#pine" transform="translate(300 520) scale(1)"/>
        <use href="#pine" transform="translate(470 500) scale(1.15)"/>
        <use href="#pine" transform="translate(1120 500) scale(1.15)"/>
        <use href="#pine" transform="translate(1290 520) scale(1)"/>
        <use href="#pine" transform="translate(1460 470) scale(1.3)"/>
    </g>
    <rect y="620" width="1600" height="200" fill="url(#mist)"/>
    <g fill="#101e29">
        <use href="#pine" transform="translate(40 420) scale(2.1)"/>
        <use href="#pine" transform="translate(250 520) scale(1.6)"/>
        <use href="#pine" transform="translate(1350 520) scale(1.6)"/>
        <use href="#pine" transform="translate(1560 420) scale(2.1)"/>
    </g>
    <path d="M0 800 Q400 760 800 790 T1600 780 V900 H0 Z" fill="#0c1720"/>

    {# lucioles #}
    <g class="fireflies" fill="#bff7ee">
        <circle cx="620" cy="650" r="2.2"/><circle cx="990" cy="610" r="1.8"/><circle cx="760" cy="720" r="1.6"/>
        <circle cx="880" cy="680" r="2"/><circle cx="540" cy="720" r="1.5"/><circle cx="1060" cy="700" r="1.7"/>
    </g>
</svg>
